# Service SIRI de Twisto — à renseigner (le service n'est pas public).
SIRI_ENDPOINT=
REQUESTOR_REF=

# Clé d'API du portail protégeant le service, envoyée en en-tête X-Gravitee-Api-Key.
# Facultative : sans elle, aucune en-tête n'est ajoutée.
SIRI_API_KEY=

# Développement : rejoue une réponse GetVehicleMonitoring enregistrée au lieu d'interroger le service.
# SIRI_FIXTURE_PATH=./twisto-vm.xml
